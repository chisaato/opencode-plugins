{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@misakacloud/opencode-skill-filter",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin: filter and hide unwanted skills to prevent context bloat and prompt conflicts",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "skills",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chisaato/opencode-plugins.git",
    "directory": "packages/skill-filter"
  },
  "author": "chisaato",
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "^2.0.16"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
