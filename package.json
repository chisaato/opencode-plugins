{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugins",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "sh -c 'set -- packages/*/package.json; if [ ! -e \"$1\" ]; then exit 0; fi; exec bun run --filter \"./packages/*\" typecheck'",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
